{
  "name": "child-health-ai-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gemini proxy for the Child Health Tracker app. Keeps the API key off the public web bundle.",
  "scripts": {
    "test": "node --test",
    "login": "wrangler login",
    "secret": "wrangler secret put GEMINI_API_KEY",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260722.1": true
  }
}
